# For local development copy these names to ignored .dev.vars.
STRIPE_SECRET_KEY=
# A test-mode price id for local development; production uses the live price.
STRIPE_PRICE_ID=
SITE_ORIGIN=http://localhost:3000
# Stripe CLI/dashboard webhook signing secret (whsec_...).
# STRIPE_WEBHOOK_SECRET=
# KEY_SECRET (license key derivation) and LICENSE_SIGNING_KEY (Ed25519 pkcs8,
# base64) are production-only secrets set with `wrangler secret put`; do not
# set them here.
